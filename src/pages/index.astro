---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandCard from '../components/brands/BrandCard.astro';
import { siteConfig } from '../config/site';
import { primaryNavigation } from '../config/navigation';
import { allBrands, brandComparisons } from '../data/brands';
import { allClients } from '../data/clients';
import { getBrandLink, AFFILIATE_REL } from '../data/links/brands';

const allSortedBrands = [...allBrands].sort((a, b) => b.editorialPriority - a.editorialPriority);
const guangsuyun = allBrands.find((b) => b.slug === 'guangsuyun')!;
const gsyLink = getBrandLink('guangsuyun')!;

const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const articles = await getCollection('articles', ({ data }) => !data.draft);
const reviews = await getCollection('reviews', ({ data }) => !data.draft);

const latestContentCards = [
  ...reviews.map((r) => ({
    title: r.data.title,
    summary: r.data.description,
    category: '品牌深度评测',
    href: `/reviews/${r.data.brandSlug}/`,
    updatedAt: r.data.updatedDate.toISOString().slice(0, 10),
  })),
  ...tutorials.map((t) => ({
    title: t.data.title,
    summary: t.data.description,
    category: `教程 · ${t.data.topic}`,
    href: `/tutorials/${t.data.topic}/${t.data.slugName}/`,
    updatedAt: t.data.updatedDate.toISOString().slice(0, 10),
  })),
  ...articles.map((a) => ({
    title: a.data.title,
    summary: a.data.description,
    category: a.data.category,
    href: `/articles/${a.id}/`,
    updatedAt: a.data.updatedDate.toISOString().slice(0, 10),
  })),
].slice(0, 9);

const homeFaqs = [
  {
    question: '机场推荐榜单中“商业推广”与“客观实测”是如何分开的？',
    answer:
      '本站明确把推广链接入口与实测数据分开管理。重点推荐品牌（如光速云）会标明商业合作与优惠码，但同时完整展示其 2026-08-19 实测中香港节点 Gemini 失败、OpenAI 仅 APP 等客观限制，不会将推广位伪装成所有项目第一名。',
  },
  {
    question: '新手第一次购买机场建议怎么选才不容易踩坑？',
    answer:
      '先确定是否需要用 Clash / Shadowrocket 等第三方客户端；若不想折腾配置可选自研客户端机场，但若重视分流自由度推荐选择兼顾自研与第三方订阅的品牌。首单建议优先选月付（¥18–¥25）或低额不限时流量包试跑晚高峰。',
  },
  {
    question: '你们的测速与解锁数据从哪里来？可以证明长期稳定吗？',
    answer:
      '测速图来自存档的 2026-08-11 MAI-TEST-BOT / Miaosu 原始截图包、2026-08-19 三网 MiaoKo 实测原图及 2026-10-19 清单快照。任何单日测试都只代表当时当地网络结果，不能单独证明全年稳定，缺乏实测的品牌在本站均明确标注“暂无可核实实测数据”。',
  },
];
---

<BaseLayout
  title={`${siteConfig.name} - 专业中文机场评测、客户端教程、线路解析与品牌数据库`}
  description={siteConfig.description}
  pathname="/"
  faqs={homeFaqs}
>
  <!-- Hero Section: Left editorial thesis + Right Network Observatory live snapshot -->
  <section class="border-b border-slate-200 bg-slate-50/60">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-brand-soft px-3 py-1 text-xs font-semibold text-brand">
            <span>十大内容专题</span>
            <span class="text-blue-300">·</span>
            <span>{allBrands.length} 家品牌实证库</span>
            <span class="text-blue-300">·</span>
            <span>SEO / GEO 结构化知识底座</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight text-slate-900 leading-[1.2]">
            面向中文用户的机场品牌评测、<br class="hidden sm:inline" />
            代理客户端教程与真实选型指南
          </h1>

          <p class="max-w-2xl text-base leading-relaxed text-slate-600">
            不搞空洞榜单与虚假“永久满分”推荐。本站将<strong>知识教程</strong>、<strong>{allBrands.length} 家品牌结构化数据库</strong>、<strong>原图级测速/解锁证据</strong>与<strong>透明套餐优惠</strong>拆分成三大独立内容体系，帮你根据本地宽带、AI 工具需求与预算做出稳妥决策。
          </p>

          <!-- Search Entry -->
          <form action="/search/" method="get" class="flex max-w-xl flex-col gap-2 sm:flex-row">
            <label for="home-search" class="sr-only">搜索机场品牌、客户端教程或报错问题</label>
            <input
              id="home-search"
              name="q"
              type="search"
              placeholder="搜品牌（光速云/星岛梦）、客户端（Clash Verge）、报错（节点超时）..."
              class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
            />
            <button
              type="submit"
              class="rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark transition-colors shrink-0"
            >
              全站搜索
            </button>
          </form>

          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-slate-600">
            <span>热门直达：</span>
            <a href="/brands/" class="rounded-md bg-white border border-slate-200 px-2.5 py-1 hover:border-brand hover:text-brand">品牌库筛选</a>
            <a href="/reviews/guangsuyun/" class="rounded-md bg-white border border-slate-200 px-2.5 py-1 hover:border-brand hover:text-brand">光速云深度评测</a>
            <a href="/clients/clash-verge-rev/" class="rounded-md bg-white border border-slate-200 px-2.5 py-1 hover:border-brand hover:text-brand">Clash Verge Rev</a>
            <a href="/ai-streaming/chatgpt/" class="rounded-md bg-white border border-slate-200 px-2.5 py-1 hover:border-brand hover:text-brand">ChatGPT 节点排查</a>
            <a href="/troubleshooting/node-timeout/" class="rounded-md bg-white border border-slate-200 px-2.5 py-1 hover:border-brand hover:text-brand">节点超时解决</a>
          </div>
        </div>

        <!-- Right: Observatory Featured Brand Snapshot (Guangsuyun) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-observatory-border bg-observatory text-slate-100 p-5 sm:p-6 observatory-grid shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <span class="font-mono text-[11px] uppercase tracking-wider text-blue-300">
                  Featured Observatory · 重点推荐档案
                </span>
                <h2 class="mt-0.5 text-lg font-bold text-white">{guangsuyun.name}（2020 年起运营）</h2>
              </div>
              <span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[11px] text-emerald-300">
                含三网实测图
              </span>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
              <div class="rounded-lg border border-slate-800 bg-observatory-surface p-3">
                <span class="text-slate-400 block">核心架构 / 协议</span>
                <span class="mt-1 block font-semibold text-white">IEPL 双线 · VLESS</span>
              </div>
              <div class="rounded-lg border border-slate-800 bg-observatory-surface p-3">
                <span class="text-slate-400 block">客户端兼容</span>
                <span class="mt-1 block font-semibold text-white">自研 + Clash/小火箭</span>
              </div>
              <div class="rounded-lg border border-slate-800 bg-observatory-surface p-3">
                <span class="text-slate-400 block">轻量年付 / 永久包</span>
                <span class="mt-1 block font-mono font-bold text-emerald-300">¥99/年 · ¥147/247G</span>
              </div>
              <div class="rounded-lg border border-slate-800 bg-observatory-surface p-3">
                <span class="text-slate-400 block">极速月付 / 优惠码</span>
                <span class="mt-1 block font-mono font-bold text-blue-300">¥25/月 · 码 {gsyLink.couponCode}</span>
              </div>
            </div>

            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-900/80 p-3 text-xs text-slate-300 leading-relaxed">
              <strong class="text-white">实测客观提示：</strong>2026-08-19 实测港/新/日均速充沛、Netflix 全解锁；但香港节点 OpenAI 仅 APP 且 Gemini 失败，AI 网页用户建议切新加坡或美/日节点。
            </div>

            <div class="mt-4 flex flex-wrap gap-2.5">
              <a
                href="/reviews/guangsuyun/"
                class="flex-1 rounded-lg border border-slate-700 bg-observatory-surface px-3.5 py-2.5 text-center text-xs font-semibold text-white hover:border-blue-400 transition-colors"
              >
                查看万字实测评测
              </a>
              <a
                href={gsyLink.affiliateUrl!}
                target="_blank"
                rel={AFFILIATE_REL}
                data-cta-track
                data-cta-brand="guangsuyun"
                data-cta-placement="home-hero-observatory"
                data-cta-content-type="home"
                class="flex-1 rounded-lg bg-brand px-3.5 py-2.5 text-center text-xs font-semibold text-white hover:bg-brand-dark transition-colors"
              >
                前往光速云官网 ↗
              </a>
            </div>
            <p class="mt-2.5 text-[11px] text-slate-400">{siteConfig.shortDisclosure}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 Primary Topic Pillars -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">全站十大内容专题体系</h2>
        <p class="mt-1 text-sm text-slate-600">对应从入门科普、软件实操、品牌决策到故障排查的完整搜索路径</p>
      </div>
      <a href="/map/" class="text-sm font-medium text-brand hover:underline">查看完整站点导航地图 →</a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        primaryNavigation.map((cat, idx) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col justify-between hover:border-brand/50 transition-colors">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-1.5">
                <span>{String(idx + 1).padStart(2, '0')}</span>
                <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">
                  {cat.system === 'A' ? '知识教程' : cat.system === 'B' ? '评测决策' : '商业专题'}
                </span>
              </div>
              <h3 class="text-base font-bold text-slate-900">
                <a href={cat.href} class="hover:text-brand">{cat.label}</a>
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600 line-clamp-2">{cat.summary}</p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-wrap gap-1.5">
              {cat.children.slice(0, 3).map((sub) => (
                <a href={sub.href} class="text-[11px] text-slate-600 hover:text-brand bg-slate-50 rounded px-1.5 py-0.5">
                  {sub.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- All 32 Brands Matrix -->
  <section class="border-y border-slate-200 bg-slate-50/70 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">全站机场品牌档案与评测入口（全部 {allSortedBrands.length} 家）</h2>
          <p class="mt-1 text-sm text-slate-600">完整展示已核验去重的 {allSortedBrands.length} 家机场品牌，严格标明实测截图来源、资料冲突与计费方式</p>
        </div>
        <div class="flex flex-wrap gap-4 text-sm font-semibold">
          <a href="/brands/" class="text-brand hover:underline">条件筛选 32 家品牌 →</a>
          <a href="/brands/planned-directory/" class="text-slate-700 hover:text-brand">扩展规划池（149 家）→</a>
          <a href="/compare/" class="text-slate-700 hover:text-brand">横向对比专题 →</a>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {allSortedBrands.map((b) => <BrandCard brand={b} />)}
      </div>
    </div>
  </section>

  <!-- Latest 9 High-Value Content Cards -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">最新深度评测、实操教程与研究文章</h2>
        <p class="mt-1 text-sm text-slate-600">每篇文章开头提供 Answer-First 核心答案、依据来源与相关排查入口</p>
      </div>
      <a href="/tutorials/" class="text-sm font-semibold text-brand hover:underline">进入使用教程中心 →</a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        latestContentCards.map((card) => (
          <article class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs text-slate-500">
                <span class="rounded bg-brand-soft px-2 py-0.5 font-medium text-brand">{card.category}</span>
                <time datetime={card.updatedAt} class="font-mono">{card.updatedAt}</time>
              </div>
              <h3 class="mt-3 text-base font-bold text-slate-900 leading-snug">
                <a href={card.href} class="hover:text-brand transition-colors">{card.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-3">{card.summary}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <a href={card.href} class="text-xs font-semibold text-brand hover:underline">阅读完整内容 →</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Clients & Troubleshooting Quick Access -->
  <section class="border-t border-slate-200 bg-slate-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 grid gap-8 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-slate-900">第三方代理客户端软件库</h2>
          <a href="/clients/" class="text-xs font-semibold text-brand hover:underline">全平台矩阵 →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            allClients.slice(0, 6).map((c) => (
              <a href={`/clients/${c.slug}/`} class="rounded-lg border border-slate-200 p-3 hover:border-brand transition-colors">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-bold text-sm text-slate-900">{c.name}</span>
                  <span class="font-mono text-[10px] text-slate-500">{c.platforms.slice(0, 2).join('/')}</span>
                </div>
                <p class="mt-1 text-xs text-slate-600 line-clamp-1">{c.coreEngine}</p>
              </a>
            ))
          }
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-slate-900">高频对比与连接故障排错</h2>
          <a href="/troubleshooting/" class="text-xs font-semibold text-brand hover:underline">故障手册 →</a>
        </div>
        <div class="space-y-2.5">
          {
            brandComparisons.slice(0, 3).map((cmp) => (
              <a href={`/compare/${cmp.slug}/`} class="block rounded-lg border border-slate-200 p-3 hover:border-brand transition-colors">
                <span class="block text-sm font-semibold text-slate-900">{cmp.title}</span>
                <span class="block mt-0.5 text-xs text-slate-500">{cmp.focusDimension}</span>
              </a>
            ))
          }
          <div class="grid grid-cols-2 gap-2 pt-1">
            <a href="/troubleshooting/node-timeout/" class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2 text-xs font-medium text-slate-700 hover:text-brand">节点全红超时排查 →</a>
            <a href="/troubleshooting/subscription-failed/" class="rounded-lg bg-slate-50 border border-slate-200 px-3 py-2 text-xs font-medium text-slate-700 hover:text-brand">订阅更新失败修复 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Homepage FAQ -->
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">常见问题与站内评测原则</h2>
    <div class="space-y-3">
      {
        homeFaqs.map((f) => (
          <details class="rounded-xl border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-sm sm:text-base text-slate-900">
              {f.question}
            </summary>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-600">{f.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
