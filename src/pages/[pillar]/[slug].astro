---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import BrandCard from '../../components/brands/BrandCard.astro';
import ComparisonMatrixTable from '../../components/comparison/ComparisonMatrixTable.astro';
import TechnicalDiagramSvg from '../../components/charts/TechnicalDiagramSvg.astro';
import SecondaryTopicShell from '../../components/topics/SecondaryTopicShell.astro';
import { primaryNavigation } from '../../config/navigation';
import { allSubTopics, type SubTopicPageData } from '../../data/topics';
import { getBrandBySlug } from '../../data/brands';
import { getClientBySlug } from '../../data/clients';
import { siteConfig, getCanonicalUrl } from '../../config/site';
import { renderInlineMarkdown, stripInlineMarkdown } from '../../lib/inlineMarkdown';

export function getStaticPaths() {
  return allSubTopics.map((topic) => ({
    params: { pillar: topic.categoryId, slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: SubTopicPageData;
}

const { topic } = Astro.props;
const parentCategory = primaryNavigation.find((c) => c.id === topic.categoryId)!;

const allTopicEntries = await getCollection('topics', ({ data }) => !data.draft);
const topicEntry = allTopicEntries.find(
  (t) => t.data.categoryId === topic.categoryId && t.data.topicSlug === topic.slug
);
const rendered = topicEntry ? await render(topicEntry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];

const activeBrandSlugs = topicEntry?.data.recommendedBrandSlugs.length
  ? topicEntry.data.recommendedBrandSlugs
  : topic.recommendedBrandSlugs || [];

const recommendedBrands = activeBrandSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));
const relatedClients = (topic.relatedClientSlugs || [])
  .map((s) => getClientBySlug(s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const allTutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const clusterEntries = [
  ...allTutorials
    .filter((t) => t.data.topic === topic.slug || t.data.parentTopicHref === topic.fullPath || t.data.pillar === parentCategory.label)
    .map((t) => ({
      title: t.data.title,
      desc: t.data.description,
      badge: `教程 · ${t.data.difficulty}`,
      href: `/tutorials/${t.data.topic}/${t.data.slugName}/`,
      date: t.data.updatedDate.toISOString().slice(0, 10),
      exactMatch: t.data.topic === topic.slug || t.data.parentTopicHref === topic.fullPath ? 1 : 0,
    })),
  ...allArticles
    .filter((a) => a.data.parentTopicHref === topic.fullPath || a.data.cluster.includes(topic.slug) || a.data.pillar === parentCategory.label)
    .map((a) => ({
      title: a.data.title,
      desc: a.data.description,
      badge: a.data.category,
      href: `/articles/${a.id}/`,
      date: a.data.updatedDate.toISOString().slice(0, 10),
      exactMatch: a.data.parentTopicHref === topic.fullPath || a.data.cluster.includes(topic.slug) ? 1 : 0,
    })),
]
  .sort((a, b) => b.exactMatch - a.exactMatch)
  .slice(0, 12);

const diagramVariant: 'tun-vs-proxy' | 'iepl-vs-transit' | 'dns-fakeip' | null =
  topic.slug === 'tun-mode'
    ? 'tun-vs-proxy'
    : topic.slug === 'iepl' || topic.slug === 'iplc' || topic.slug === 'stable'
    ? 'iepl-vs-transit'
    : topic.slug === 'dns-error'
    ? 'dns-fakeip'
    : null;

const pageTitle = topicEntry?.data.title ?? topic.title;
const pageDescription = topicEntry?.data.description ?? topic.description;
const pageH1 = topicEntry?.data.h1 ?? topic.h1;
const pageAnswerFirst = topicEntry?.data.answerFirst ?? topic.answerFirst;
const pageFaqs = (topicEntry?.data.faqs.length ? topicEntry.data.faqs : topic.faqs).map((f) => ({
  question: stripInlineMarkdown(f.question),
  answer: stripInlineMarkdown(f.answer),
}));
const rawFaqs = topicEntry?.data.faqs.length ? topicEntry.data.faqs : topic.faqs;
const pageUpdated = topicEntry?.data.updatedDate
  ? topicEntry.data.updatedDate.toISOString().slice(0, 10)
  : topic.updatedAt;

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: parentCategory.label, href: parentCategory.href },
  { label: topicEntry?.data.primaryKeyword ?? topic.primaryKeyword, href: topic.fullPath },
];

const topicSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    description: pageDescription,
    url: getCanonicalUrl(topic.fullPath),
    inLanguage: 'zh-CN',
    isPartOf: {
      '@type': 'WebPage',
      name: parentCategory.label,
      url: getCanonicalUrl(parentCategory.href),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageH1,
    description: pageDescription,
    dateModified: pageUpdated,
    author: {
      '@type': 'Organization',
      name: siteConfig.editorialEntity,
      url: getCanonicalUrl('/about/'),
    },
    mainEntityOfPage: getCanonicalUrl(topic.fullPath),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pathname={topic.fullPath}
  ogType="article"
  modifiedTime={pageUpdated}
  breadcrumbs={breadcrumbs}
  faqs={pageFaqs}
  jsonLdExtra={topicSchemas}
>
  <article class="mx-auto max-w-7xl px-4 py-8 sm:px-6 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Header & GEO Answer-First -->
    <header class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
        <span class="rounded bg-brand-soft px-2.5 py-0.5 font-semibold text-brand">
          {parentCategory.label} · 二级专题枢纽 · {topicEntry?.data.searchIntent ?? topic.searchIntent}
        </span>
        <span class="text-slate-500">最后核验更新：{pageUpdated}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">{pageH1}</h1>

      <div class="rounded-xl border border-blue-200 bg-brand-soft/60 p-4 sm:p-5">
        <span class="block font-mono text-xs font-bold uppercase tracking-wider text-brand mb-1.5">
          Answer-First · 核心直接回答
        </span>
        <p class="text-sm sm:text-base leading-relaxed text-slate-800" set:html={renderInlineMarkdown(pageAnswerFirst)} />
      </div>

      {
        topicEntry?.data.entityChain && topicEntry.data.entityChain.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5 text-xs">
            <span class="font-semibold text-slate-500 mr-1">决策链路：</span>
            {topicEntry.data.entityChain.map((item, idx) => (
              <>
                <span class="rounded-md bg-slate-50 border border-slate-200 px-2.5 py-1 text-slate-700 font-medium">
                  {item}
                </span>
                {idx < topicEntry.data.entityChain.length - 1 && (
                  <span class="text-slate-400 font-mono">→</span>
                )}
              </>
            ))}
          </div>
        )
      }

      {topic.keyFacts.length > 0 && (
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">核心事实要点</h2>
          <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm text-slate-700">
            {topic.keyFacts.map((kf) => <li>{kf}</li>)}
          </ul>
        </div>
      )}
    </header>

    <!-- Quick Decision Comparison Table for Commercial / Selection Pages -->
    {recommendedBrands.length > 0 && (
      <ComparisonMatrixTable
        brands={recommendedBrands}
        title={`「${topicEntry?.data.primaryKeyword ?? topic.primaryKeyword}」关联品牌对比速查`}
        placement={`topic-${topic.categoryId}-${topic.slug}`}
      />
    )}

    <!-- Technical Vector Diagram (if applicable) -->
    {diagramVariant && <TechnicalDiagramSvg variant={diagramVariant} />}

    <!-- Main Structured Body Sections: Upgraded Markdown Shell OR Legacy Structured Sections -->
    {
      topicEntry && Content ? (
        <SecondaryTopicShell
          headings={headings}
          recommendedBrands={recommendedBrands}
          articleClusters={topicEntry.data.articleClusters}
          crossTopicLinks={topicEntry.data.crossTopicLinks}
          decisionCriteria={topicEntry.data.decisionCriteria}
          dataGapNotes={topicEntry.data.dataGapNotes}
          sources={topicEntry.data.sources}
          topicLabel={topicEntry.data.primaryKeyword}
          parentHref={parentCategory.href}
          parentLabel={parentCategory.label}
          updatedAt={pageUpdated}
        >
          <Content />
        </SecondaryTopicShell>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 prose-zh max-w-none space-y-6">
          {
            topic.sections.map((sec) => (
              <section>
                <h2>{sec.heading}</h2>
                {sec.paragraphs.map((p) => <p>{p}</p>)}
                {sec.bullets && sec.bullets.length > 0 && (
                  <ul>
                    {sec.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </section>
            ))
          }
        </div>
      )
    }

    <!-- Cluster Deep Articles & Tutorials (System A / B / C Hub Linkage) -->
    {clusterEntries.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-slate-900">本专题下属深度集群文章与实操教程</h2>
          <span class="font-mono text-xs text-slate-500">Cluster Guides</span>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {clusterEntries.map((ce) => (
            <article class="rounded-xl border border-slate-200 bg-white p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
                  <span class="rounded bg-brand-soft px-2 py-0.5 font-medium text-brand">{ce.badge}</span>
                  <span class="font-mono">{ce.date}</span>
                </div>
                <h3 class="text-base font-bold text-slate-900 leading-snug">
                  <a href={ce.href} class="hover:text-brand">{ce.title}</a>
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-slate-600 line-clamp-3">{ce.desc}</p>
              </div>
              <div class="mt-3 pt-2.5 border-t border-slate-100">
                <a href={ce.href} class="text-xs font-semibold text-brand hover:underline">阅读全文 →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Recommended Brands (if applicable) -->
    {recommendedBrands.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-slate-900">本专题相关推荐与对照品牌</h2>
          <a href="/brands/" class="text-xs font-semibold text-brand hover:underline">全部 32 家筛选 →</a>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {recommendedBrands.map((b) => <BrandCard brand={b} />)}
        </div>
      </section>
    )}

    <!-- Related Clients -->
    {relatedClients.length > 0 && (
      <section class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900">相关客户端软件指南</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedClients.map((c) => (
            <a href={`/clients/${c.slug}/`} class="rounded-lg border border-slate-200 p-3.5 hover:border-brand transition-colors">
              <span class="font-bold text-sm text-slate-900 block">{c.name}</span>
              <span class="text-xs text-slate-500 mt-1 block">{c.platforms.join(' / ')}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ -->
    {rawFaqs.length > 0 && (
      <section id="topic-faq" class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 scroll-mt-24">
        <h2 class="text-xl font-bold text-slate-900 mb-4">常见问题解答（{rawFaqs.length} 题）</h2>
        <div class="space-y-3">
          {rawFaqs.map((f, idx) => (
            <details open={idx < 2} class="rounded-lg border border-slate-200 p-4">
              <summary class="cursor-pointer font-semibold text-sm text-slate-900">{idx + 1}. {f.question}</summary>
              <p class="mt-2 text-sm leading-relaxed text-slate-600" set:html={renderInlineMarkdown(f.answer)} />
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Internal Links & Sibling Topics -->
    <section class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-sm font-bold text-slate-900 mb-3">延伸阅读与内部链接</h2>
        <ul class="space-y-2 text-sm">
          {topic.relatedLinks.map((rl) => (
            <li><a href={rl.href} class="text-brand hover:underline">→ {rl.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-sm font-bold text-slate-900 mb-3">同级「{parentCategory.label}」相关栏目</h2>
        <div class="flex flex-wrap gap-2">
          {parentCategory.children.map((sub) => (
            <a
              href={sub.href}
              class:list={[
                'rounded-lg border px-3 py-1.5 text-xs font-medium',
                sub.href === topic.fullPath
                  ? 'border-brand bg-brand-soft text-brand font-semibold'
                  : 'border-slate-200 bg-white text-slate-700 hover:border-brand',
              ]}
            >
              {sub.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
