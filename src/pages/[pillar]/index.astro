---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import BrandCard from '../../components/brands/BrandCard.astro';
import PillarIntentModules from '../../components/pillars/PillarIntentModules.astro';
import PillarGuideSection from '../../components/pillars/PillarGuideSection.astro';
import { primaryNavigation, type NavCategory } from '../../config/navigation';
import { getCanonicalUrl } from '../../config/site';
import { getSubTopicsByCategory } from '../../data/topics';
import { getBrandBySlug, getFeaturedBrands } from '../../data/brands';
import { renderInlineMarkdown, stripInlineMarkdown } from '../../lib/inlineMarkdown';

export function getStaticPaths() {
  const excluded = new Set(['brands', 'clients']);
  return primaryNavigation
    .filter((cat) => !excluded.has(cat.id))
    .map((cat) => ({
      params: { pillar: cat.id },
      props: { category: cat },
    }));
}

interface Props {
  category: NavCategory;
}

const { category } = Astro.props;
const subTopics = getSubTopicsByCategory(category.id);
const featuredBrands = getFeaturedBrands().slice(0, 3);

const allPillars = await getCollection('pillars', ({ data }) => !data.draft);
const pillarEntry = allPillars.find((p) => p.data.pillarId === category.id);
const rendered = pillarEntry ? await render(pillarEntry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];

const recommendedBrands = pillarEntry?.data.recommendedBrandSlugs.length
  ? pillarEntry.data.recommendedBrandSlugs
      .map((s) => getBrandBySlug(s))
      .filter((b): b is NonNullable<typeof b> => Boolean(b))
  : getFeaturedBrands();

const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const articles = await getCollection('articles', ({ data }) => !data.draft);
const relatedArticles = [
  ...tutorials.filter((t) => t.data.pillar === category.label).map((t) => ({
    title: t.data.title,
    desc: t.data.description,
    href: `/tutorials/${t.data.topic}/${t.data.slugName}/`,
  })),
  ...articles.filter((a) => a.data.pillar === category.label).map((a) => ({
    title: a.data.title,
    desc: a.data.description,
    href: `/articles/${a.id}/`,
  })),
];

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: category.label, href: category.href },
];

const pageTitle = pillarEntry?.data.title ?? `${category.label}：${category.pillarTitle}`;
const pageDescription = pillarEntry?.data.description ?? category.summary;
const h1Text = pillarEntry?.data.h1 ?? category.pillarTitle;

const collectionSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    description: pageDescription,
    url: getCanonicalUrl(category.href),
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${category.label}核心二级栏目与导航`,
    numberOfItems: category.children.length,
    itemListElement: category.children.map((sub, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: sub.label,
      url: getCanonicalUrl(sub.href),
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pathname={category.href}
  breadcrumbs={breadcrumbs}
  faqs={(pillarEntry?.data.faqs ?? []).map((f) => ({
    question: stripInlineMarkdown(f.question),
    answer: stripInlineMarkdown(f.answer),
  }))}
  jsonLdExtra={collectionSchema}
  publishedTime={pillarEntry?.data.pubDate.toISOString().slice(0, 10)}
  modifiedTime={pillarEntry?.data.updatedDate?.toISOString().slice(0, 10)}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 space-y-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8 space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="rounded bg-brand-soft px-2.5 py-0.5 font-semibold text-brand">
          体系 {category.system} · 一级专题枢纽
        </span>
        <span class="text-slate-500">下辖 {category.children.length} 个独立二级专题</span>
        {pillarEntry?.data.searchIntent && (
          <span class="rounded bg-white border border-slate-200 px-2 py-0.5 text-slate-600">
            意图：{pillarEntry.data.searchIntent}
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">{h1Text}</h1>

      {
        pillarEntry?.data.answerFirst ? (
          <div class="rounded-xl border border-brand/20 bg-white p-4 sm:p-5 space-y-2 shadow-xs">
            <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-brand">
              Answer-First · 核心结论直达
            </div>
            <p
              class="text-sm sm:text-[15px] leading-relaxed text-slate-700"
              set:html={renderInlineMarkdown(pillarEntry.data.answerFirst)}
            />
          </div>
        ) : (
          <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-slate-600">{category.summary}</p>
        )
      }

      {
        pillarEntry?.data.entityChain && pillarEntry.data.entityChain.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs">
            <span class="font-semibold text-slate-500 mr-1">知识实体链：</span>
            {pillarEntry.data.entityChain.map((item, idx) => (
              <>
                <span class="rounded-md bg-white border border-slate-200 px-2.5 py-1 text-slate-700 font-medium">
                  {item}
                </span>
                {idx < pillarEntry.data.entityChain.length - 1 && (
                  <span class="text-slate-400 font-mono">→</span>
                )}
              </>
            ))}
          </div>
        )
      }
    </header>

    <!-- Mode-Specific Specialized Decision / Diagram / Triage Module -->
    {
      pillarEntry && (
        <PillarIntentModules
          layoutMode={pillarEntry.data.layoutMode}
          brands={recommendedBrands}
          pillarLabel={category.label}
        />
      )
    }

    <!-- Sub-Topic Cards -->
    <section>
      <h2 class="text-xl font-bold text-slate-900 mb-5">本专题下属全部二级栏目</h2>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          category.children.map((sub) => {
            const detail = subTopics.find((t) => t.fullPath === sub.href);
            return (
              <article class="rounded-xl border border-slate-200 bg-white p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                  <div class="flex items-center justify-between text-xs font-mono text-slate-500 mb-2">
                    <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-700">{sub.intent}</span>
                    {detail && <span>更新 {detail.updatedAt}</span>}
                  </div>
                  <h3 class="text-lg font-bold text-slate-900">
                    <a href={sub.href} class="hover:text-brand">{sub.label}</a>
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">
                    {detail ? stripInlineMarkdown(detail.answerFirst).slice(0, 110) + '...' : sub.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100">
                  <a href={sub.href} class="text-xs font-semibold text-brand hover:underline">
                    进入「{sub.label}」专题 →
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Long-Form Pillar Editorial Prose + Sticky TOC + FAQs + Cross-Pillar -->
    {
      pillarEntry && Content && (
        <PillarGuideSection
          headings={headings}
          recommendedBrands={recommendedBrands}
          crossPillarLinks={pillarEntry.data.crossPillarLinks}
          faqs={pillarEntry.data.faqs}
          dataGapNotes={pillarEntry.data.dataGapNotes}
          sources={pillarEntry.data.sources}
          pillarLabel={category.label}
          updatedAt={pillarEntry.data.updatedDate?.toISOString().slice(0, 10)}
        >
          <Content />
        </PillarGuideSection>
      )
    }

    {relatedArticles.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-slate-900 mb-4">关联深度教程与专题文章</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {relatedArticles.map((art) => (
            <a href={art.href} class="rounded-xl border border-slate-200 bg-white p-5 hover:border-brand transition-colors">
              <h3 class="font-bold text-base text-slate-900">{art.title}</h3>
              <p class="mt-1.5 text-sm text-slate-600 line-clamp-2">{art.desc}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Commercial / Brand Bridge -->
    <section class="border-t border-slate-200 pt-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-900">相关可核验品牌档案参考</h2>
        <a href="/brands/" class="text-sm font-semibold text-brand hover:underline">查看全部 32 家品牌 →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {featuredBrands.map((b) => <BrandCard brand={b} />)}
      </div>
    </section>
  </div>
</BaseLayout>
