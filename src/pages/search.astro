---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '全站静态全文搜索', href: '/search/' },
];
---

<BaseLayout
  title="全站搜索 - 检索机场品牌、测速评测、客户端教程与故障排查"
  description="基于 Pagefind 静态全文检索，支持快速查找 32 家机场品牌、优惠码、Clash Verge Rev / Shadowrocket 教程及连接报错解法。"
  pathname="/search/"
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 space-y-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">全站静态全文搜索（Pagefind）</h1>
      <p class="mt-2 text-sm text-slate-600">
        支持搜索机场名称（如“光速云”“星岛梦”）、协议（“VLESS”“IEPL”）、优惠码、客户端软件或故障关键词（“节点超时”“Gemini”）。
      </p>
    </div>

    <div id="pagefind-search" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 min-h-[260px]">
      <noscript>
        <p class="text-sm text-slate-600">请启用 JavaScript 使用交互搜索，或前往 <a href="/map/" class="text-brand underline">HTML 网站地图</a> 浏览全站页面。</p>
      </noscript>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-bold text-slate-900 mb-3">高频搜索直达入口</h2>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/brands/guangsuyun/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">光速云</a>
        <a href="/reviews/guangsuyun/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">光速云评测</a>
        <a href="/clients/clash-verge-rev/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">Clash Verge Rev</a>
        <a href="/clients/shadowrocket/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">Shadowrocket 小火箭</a>
        <a href="/ai-streaming/chatgpt/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">ChatGPT 机场</a>
        <a href="/pricing/cheap/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">便宜机场</a>
        <a href="/troubleshooting/node-timeout/" class="rounded-md bg-slate-100 px-3 py-1.5 hover:bg-brand-soft hover:text-brand">节点超时</a>
      </div>
    </div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('pagefind-search');
      if (typeof window.PagefindUI !== 'undefined') {
        const ui = new window.PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '输入关键词搜索全站内容...',
            zero_results: '未找到与 [SEARCH_TERM] 相关的内容',
            many_results: '共找到 [COUNT] 条相关结果',
            one_result: '找到 1 条结果',
            clear_search: '清空',
          },
        });
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q) ui.triggerSearch(q);
      } else if (container) {
        container.innerHTML =
          '<p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-4">提示：Pagefind 索引在运行生产构建（<code>npm run build</code>）后生成；当前开发预览环境下请先使用下方快捷入口或 <a href="/brands/" class="underline font-semibold">品牌库实时筛选</a>。</p>';
      }
    });
  </script>
</BaseLayout>
