---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { allBrands } from '../../data/brands';
import { getCanonicalUrl } from '../../config/site';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '机场品牌', href: '/brands/' },
  { label: '机场套餐价格总表', href: '/brands/pricing-table/' },
];

const brandsSortedByPrice = [...allBrands].sort(
  (a, b) => (a.lowestMonthlyCny ?? 999) - (b.lowestMonthlyCny ?? 999)
);

const faqs = [
  {
    question: '为什么表里有些“¥5.6/月”或“¥8.25/月”排在最前面，点进详情却显示要花近百元？',
    answer:
      '因为它们是按“年付套餐总价 ÷ 12 个月”算出来的折算月均成本（如飞猫云 ¥84/年 ≈ ¥7/月、星岛梦 ¥96/年 ≈ ¥8/月、光速云轻量版 ¥99/年 ≈ ¥8.25/月），并非允许单月买 5–8 块钱。若只需单月购买随时退出，请直接核对表格第 3 列「是否支持月付」中的明确标价。',
  },
  {
    question: '如何用这份价格总表选出真正最低沉没成本的起步套餐？',
    answer:
      '初次试用新品牌建议重点对比第 3 列的真月付（例如唯兔云 ¥19.9、一翻云 ¥20、极连云/光年梯 ¥18、光速云 ¥25）；每月总流量消耗稳定在 20GB 以内的用户，优先核查第 4 列支持「不限时永久流量包」的品牌（如光速云 ¥147/247GB、二猫云 ¥99/100GB、唯兔云 ¥100/100GB）。',
  },
  {
    question: '为什么部分品牌的最低参考口径或年付档标注了口径冲突？',
    answer:
      '在核查原始 32 家品牌资料时，部分条目在不同表格/文段之间存在交叉差异（如微风网络同时记录 7 元与 ¥137/年、灵猫云存在 19 元与 25 元差异、宇宙云历史 ¥96/年未写明月流量、快狸缺乏公开文本报价）。本站严格保留异常提示，请以各品牌官方结算台为准。',
  },
  {
    question: '总表里的标称月流量能直接按字节 1:1 用完吗？',
    answer:
      '取决于节点的消耗倍率（Multiplier）。如星岛梦标注全节点 1x 计费即可足额消费，若遇到部分套餐内标注 2x、3x 专线或稀有家宽节点，实际耗费额度会乘以对应倍数，建议配合规则分流并仔细查看详情页各阶梯套餐说明。',
  },
];

const jsonLdExtra = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '2026 全站 32 家机场套餐价格总表',
  description: '区分月付、年付折算月成本及永久不限时一次性包的完整 32 家机场价格矩阵。',
  url: getCanonicalUrl('/brands/pricing-table/'),
};
---

<BaseLayout
  title="2026 机场套餐价格总表：区分月付价、年付折算价与永久流量包"
  description="全站 32 家机场品牌价格总览，严格区分年付平均月成本、真实月付最低档与不限时一次性流量包价格。"
  pathname="/brands/pricing-table/"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  jsonLdExtra={jsonLdExtra}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 space-y-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
        机场套餐价格总表（月付 / 年付折算 / 不限时对照）
      </h1>
      <p class="mt-2.5 text-sm sm:text-base text-slate-600 leading-relaxed">
        本表严格区分“年付折算月成本”和“真实单月购买门槛”，避免将 ¥99/年 写成可按 ¥8.25 单买一个月。点击品牌名称可查看其完整各阶梯套餐列表。
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700">
            <th class="px-4 py-3">品牌</th>
            <th class="px-4 py-3">最低参考起步口径</th>
            <th class="px-4 py-3">是否支持月付</th>
            <th class="px-4 py-3">是否支持不限时包</th>
            <th class="px-4 py-3">线路与协议</th>
            <th class="px-4 py-3">核验时间</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            brandsSortedByPrice.map((b) => {
              const firstMonthly = b.pricingPlans.find((p) => p.billingCycle === 'monthly');
              const firstOneTime = b.pricingPlans.find((p) => p.billingCycle === 'one-time');
              return (
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 font-semibold text-slate-900">
                    <a href={`/brands/${b.slug}/`} class="hover:text-brand">{b.name}</a>
                  </td>
                  <td class="px-4 py-3 text-xs font-mono text-slate-800">{b.lowestMonthlyLabel}</td>
                  <td class="px-4 py-3 text-xs">
                    {firstMonthly ? (
                      <span class="font-mono font-semibold text-blue-700">¥{firstMonthly.priceCny}/月 ({firstMonthly.trafficDisplay})</span>
                    ) : b.hasMonthlyPlan ? (
                      <span class="text-slate-600">支持（见详情）</span>
                    ) : (
                      <span class="text-slate-400">待核实</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-xs">
                    {firstOneTime ? (
                      <span class="font-mono font-semibold text-emerald-700">¥{firstOneTime.priceCny} ({firstOneTime.trafficDisplay})</span>
                    ) : (
                      <span class="text-slate-400">暂无记录</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-xs text-slate-600">{b.routeTypes[0]} · {b.protocols[0]}</td>
                  <td class="px-4 py-3 font-mono text-xs text-slate-500">{b.verifiedAt}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 space-y-3">
        <h2 class="text-lg font-bold text-slate-900">看懂机场套餐定价的 3 条核对标准</h2>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm leading-relaxed text-slate-600">
          <li><strong>看清真月付 vs 年付均摊</strong>：真月付集中在 ¥14.9–¥25（适合首月测试），年付均摊低至 ¥5.6–¥8.25 但需整年付款。</li>
          <li><strong>核查数据完整度</strong>：表格末尾或标“待核实”条目包含缺少测速图（如 5.6 元同质化档、尾部历史档案）及口径待对齐记录。</li>
          <li><strong>叠算单 GB 真实花费</strong>：使用公式 <code>实际总价 ÷ (流量GB ÷ 倍率)</code>，避免被隐藏的高倍率消耗拉高实际单价。</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-slate-50 p-6 space-y-3">
        <h2 class="text-lg font-bold text-slate-900">延伸关联选购专题</h2>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/pricing/monthly/" class="font-semibold text-brand hover:underline">→ 月付机场专题（¥14.9–¥25 真实可单月起购）</a></li>
          <li><a href="/pricing/unlimited-time/" class="font-semibold text-brand hover:underline">→ 不限时永久流量包专题（低频与备份防失联）</a></li>
          <li><a href="/pricing/value/" class="font-semibold text-brand hover:underline">→ 性价比精算专题（单 GB 成本与多设备价值）</a></li>
          <li><a href="/brands/coupons/" class="font-semibold text-brand hover:underline">→ 优惠码汇总页（查 8折/9折适用限制与冲突）</a></li>
        </ul>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
      <h2 class="text-lg font-bold text-slate-900">套餐价格对比常见问题</h2>
      <div class="space-y-2.5">
        {faqs.map((f, idx) => (
          <details open={idx === 0} class="rounded-lg border border-slate-200 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-slate-900">{idx + 1}. {f.question}</summary>
            <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
