---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { allBrands } from '../../data/brands';
import { brandLinks, AFFILIATE_REL } from '../../data/links/brands';
import { siteConfig, getCanonicalUrl } from '../../config/site';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '机场品牌', href: '/brands/' },
  { label: '机场官网导航', href: '/brands/official-links/' },
];

const faqs = [
  {
    question: '为什么有部分品牌标记为「格式提醒」（如云界线、环球梯）？',
    answer:
      '许多机场后台采用前后端分离单页应用架构，推广网址标准格式通常需携带 `#/` 哈希路由符（例如 `https://domain/#/?code=...`）。我们在核查原始清单时发现云界线与环球梯提供链接缺少 `#/`，访问时有几率遇到页面白屏或找不到路由，因此标注格式提醒建议核对品牌页确认。',
  },
  {
    question: '怎么防备在搜索引擎搜某品牌官网时点进高仿钓鱼假站？',
    answer:
      '一是切忌盲目点击搜索引擎结果页最上方的推广广告或谐音假拼写域名；二是通过本站统一管理的来源链接表比对，并且检查浏览器是否提示 HTTPS 证书无效；三是严禁在任何未知第三方小站复用微信/常用邮箱同款主密码。',
  },
  {
    question: '如果官网突然进不去或显示被当地宽带 DNS 劫持怎么办？',
    answer:
      '机场面向大陆直连域名有时会被部分省市宽带临时屏蔽。常规做法可先尝试切换手机 5G 热点访问一次确认是否本地宽带屏蔽，或者通过该品牌此前发布的备用防丢失邮箱通知获取最新镜像发布页，切勿轻信贴吧评论区不明个人发的新链。',
  },
];

const jsonLdExtra = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '2026 机场官网导航与注册入口核验清单',
  description: '集中管理 32 家机场品牌官网直达链接状态、格式提醒与防钓鱼核验建议。',
  url: getCanonicalUrl('/brands/official-links/'),
};
---

<BaseLayout
  title="机场官网导航与注册入口核验清单（32家去重汇总）"
  description="集中汇总 32 家机场品牌核验注册入口，标明链接格式异常警告（如云界线、环球梯缺少 #/）及纯实测无链接档案，防假冒钓鱼站。"
  pathname="/brands/official-links/"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  jsonLdExtra={jsonLdExtra}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 space-y-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
        机场官网导航：各品牌集中管理注册入口与链接核验
      </h1>
      <p class="mt-2.5 text-sm sm:text-base text-slate-600 leading-relaxed">
        为防止假冒钓鱼网站风险，全站所有品牌跳转链接均从统一数据文件 <code>src/data/links/brands.ts</code> 读取，并强制附加 <code>rel="nofollow sponsored noopener"</code>。{siteConfig.affiliateDisclosure}
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700">
            <th class="px-4 py-3">品牌</th>
            <th class="px-4 py-3">链接状态</th>
            <th class="px-4 py-3">核验优惠码</th>
            <th class="px-4 py-3">备注 / 异常提醒</th>
            <th class="px-4 py-3 text-right">入口</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            allBrands.map((b) => {
              const rec = brandLinks[b.slug];
              return (
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 font-semibold text-slate-900">
                    <a href={`/brands/${b.slug}/`} class="hover:text-brand">{b.name}</a>
                  </td>
                  <td class="px-4 py-3 text-xs">
                    {rec?.linkStatus === 'verified-from-source' && (
                      <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-emerald-700">来源核验</span>
                    )}
                    {rec?.linkStatus === 'format-anomaly' && (
                      <span class="rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-amber-800">格式提醒</span>
                    )}
                    {rec?.linkStatus === 'missing-affiliate' && (
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">暂缺链接</span>
                    )}
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-slate-800">{rec?.couponCode || '—'}</td>
                  <td class="px-4 py-3 text-xs text-slate-600 max-w-md">
                    {rec?.linkFormatNote || rec?.officialDomainNote || rec?.sourceRef}
                  </td>
                  <td class="px-4 py-3 text-right">
                    {rec?.affiliateUrl ? (
                      <a
                        href={rec.affiliateUrl}
                        target="_blank"
                        rel={AFFILIATE_REL}
                        data-cta-track
                        data-cta-brand={b.slug}
                        data-cta-placement="official-links-table"
                        data-cta-content-type="navigation"
                        class="inline-block rounded-md bg-brand px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-dark"
                      >
                        访问官网 ↗
                      </a>
                    ) : (
                      <a href={`/brands/${b.slug}/`} class="text-xs text-slate-500 hover:text-brand">查看档案</a>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 space-y-2.5">
        <h2 class="text-lg font-bold text-slate-900">链接核验分级标准与防钓鱼安全原则</h2>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
          <li><strong>来源核验（绿标）</strong>：链接直接取自原始资料清单且携带规范路由与注册码格式，并统一附加 <code>rel="nofollow sponsored noopener"</code>。</li>
          <li><strong>格式提醒（黄标）</strong>：如云界线与环球梯缺少 `#/` 路由符，访问前留意页面加载状态。</li>
          <li><strong>暂缺链接（灰标）</strong>：如「快狸」仅留存实测截图缺乏原始文字网址、「灵动云/浪网/EdgeNova」资料稀疏待补，不伪造跳转地址。</li>
        </ul>
      </section>
      <section class="rounded-2xl border border-slate-200 bg-slate-50 p-6 space-y-2.5">
        <h2 class="text-lg font-bold text-slate-900">下一步核查与选型导航</h2>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/brands/" class="font-semibold text-brand hover:underline">→ 32 家机场实时条件筛选数据库</a></li>
          <li><a href="/jichang/reliable/" class="font-semibold text-brand hover:underline">→ 靠谱机场筛选标准（核验年限与跨文档一致性）</a></li>
          <li><a href="/risks/exit-scam/" class="font-semibold text-brand hover:underline">→ 机场跑路前兆识别与紧急迁移手册</a></li>
          <li><a href="/brands/planned-directory/" class="font-semibold text-brand hover:underline">→ 查看 149 家未正式入库扩展规划池名录</a></li>
        </ul>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
      <h2 class="text-lg font-bold text-slate-900">官网入口与域名访问常见问题</h2>
      <div class="space-y-2.5">
        {faqs.map((f, idx) => (
          <details open={idx === 0} class="rounded-lg border border-slate-200 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-slate-900">{idx + 1}. {f.question}</summary>
            <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
