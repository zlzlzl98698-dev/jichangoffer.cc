---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import BrandCard from '../../components/brands/BrandCard.astro';
import TechnicalDiagramSvg from '../../components/charts/TechnicalDiagramSvg.astro';
import { getBrandBySlug } from '../../data/brands';
import { siteConfig, getCanonicalUrl } from '../../config/site';
import { renderInlineMarkdown, stripInlineMarkdown } from '../../lib/inlineMarkdown';
import { findPillarCategory } from '../../lib/contentLinks';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'articles'>>>[number];
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pathname = `/articles/${entry.id}/`;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const parentPillar = findPillarCategory(entry.data.pillar);

const relatedBrands = entry.data.relatedBrandSlugs
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const siblingArticles = [
  ...entry.data.relatedArticleSlugs
    .map((slug) => allArticles.find((a) => a.id === slug))
    .filter((a): a is NonNullable<typeof a> => Boolean(a)),
  ...allArticles.filter(
    (a) =>
      a.id !== entry.id &&
      !entry.data.relatedArticleSlugs.includes(a.id) &&
      (a.data.parentTopicHref === entry.data.parentTopicHref || a.data.pillar === entry.data.pillar)
  ),
].slice(0, 4);

const diagramVariant: 'tun-vs-proxy' | 'iepl-vs-transit' | 'dns-fakeip' | null =
  entry.id.includes('iepl') || entry.id.includes('isp-')
    ? 'iepl-vs-transit'
    : entry.id.includes('fake-ip') || entry.id.includes('dns')
    ? 'dns-fakeip'
    : null;

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: parentPillar?.label || entry.data.pillar, href: parentPillar?.href || '/' },
  ...(entry.data.parentTopicHref && entry.data.parentTopicLabel
    ? [{ label: entry.data.parentTopicLabel, href: entry.data.parentTopicHref }]
    : []),
  { label: entry.data.primaryKeyword, href: pathname },
];

const cleanFaqs = entry.data.faqs.map((f) => ({
  question: stripInlineMarkdown(f.question),
  answer: stripInlineMarkdown(f.answer),
}));

const showCommercialBrands =
  relatedBrands.length > 0 && entry.data.ctaMode !== 'task-only';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.h1 || entry.data.title,
  description: entry.data.description,
  image: `${siteConfig.siteUrl.replace(/\/+$/, '')}/og-default.png`,
  articleSection: entry.data.category,
  keywords: [entry.data.primaryKeyword, ...entry.data.secondaryKeywords].filter(Boolean).join(', '),
  datePublished: entry.data.pubDate.toISOString().slice(0, 10),
  dateModified: entry.data.updatedDate.toISOString().slice(0, 10),
  author: {
    '@type': 'Organization',
    name: entry.data.author,
    url: getCanonicalUrl('/about/'),
  },
  mainEntityOfPage: getCanonicalUrl(pathname),
  isPartOf: entry.data.parentTopicHref
    ? {
        '@type': 'CollectionPage',
        name: entry.data.parentTopicLabel || entry.data.pillar,
        url: getCanonicalUrl(entry.data.parentTopicHref),
      }
    : undefined,
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  pathname={pathname}
  ogType="article"
  publishedTime={entry.data.pubDate.toISOString().slice(0, 10)}
  modifiedTime={entry.data.updatedDate.toISOString().slice(0, 10)}
  breadcrumbs={breadcrumbs}
  faqs={cleanFaqs}
  jsonLdExtra={articleSchema}
>
  <article class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8 space-y-8 min-w-0">
        <header class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
            <span class="rounded bg-brand-soft px-2.5 py-0.5 font-semibold text-brand">
              {entry.data.category} · {entry.data.searchIntent}
            </span>
            <span class="text-slate-500">
              发布：{entry.data.pubDate.toISOString().slice(0, 10)} · 更新：{entry.data.updatedDate.toISOString().slice(0, 10)}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
            {entry.data.h1 || entry.data.title}
          </h1>

          {entry.data.audience && (
            <p class="text-xs font-mono text-slate-500">
              适用人群与前置范围：{entry.data.audience}
            </p>
          )}

          <div class="rounded-xl border border-blue-200 bg-brand-soft/60 p-4">
            <span class="block font-mono text-xs font-bold uppercase tracking-wider text-brand mb-1">
              Answer-First · 核心解答
            </span>
            <p
              class="text-sm sm:text-base leading-relaxed text-slate-800"
              set:html={renderInlineMarkdown(entry.data.answerFirst)}
            />
          </div>

          {entry.data.parentTopicHref && entry.data.parentTopicLabel && (
            <div class="flex flex-wrap items-center gap-3 text-xs pt-1">
              <a
                href={entry.data.parentTopicHref}
                class="rounded-lg border border-slate-300 bg-slate-50 px-3 py-1.5 font-semibold text-slate-800 hover:border-brand hover:text-brand"
              >
                ← 所属二级专题：{entry.data.parentTopicLabel}
              </a>
              {parentPillar && (
                <a
                  href={parentPillar.href}
                  class="rounded-lg border border-slate-200 px-3 py-1.5 text-slate-600 hover:border-brand hover:text-brand"
                >
                  一级枢纽：{parentPillar.label}
                </a>
              )}
            </div>
          )}
        </header>

        {headings.length > 0 && (
          <details class="lg:hidden rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <summary class="cursor-pointer font-mono text-xs font-bold uppercase tracking-wider text-slate-800">
              展开本文目录（{headings.filter((h) => h.depth <= 3).length} 节）
            </summary>
            <ul class="mt-3 space-y-1.5 text-xs border-t border-slate-200 pt-3">
              {headings.filter((h) => h.depth <= 3).map((h) => (
                <li class={h.depth === 3 ? 'pl-3' : ''}>
                  <a href={`#${h.slug}`} class="text-slate-700 hover:text-brand">{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        {diagramVariant && <TechnicalDiagramSvg variant={diagramVariant} />}

        <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 prose-zh max-w-none">
          <Content />
        </section>

        {entry.data.faqs.length > 0 && (
          <section class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="text-xl font-bold text-slate-900 mb-4">常见问题解答（{entry.data.faqs.length} 题）</h2>
            <div class="space-y-3">
              {entry.data.faqs.map((f, idx) => (
                <details open={idx === 0} class="rounded-lg border border-slate-200 p-4">
                  <summary class="cursor-pointer font-semibold text-sm text-slate-900">{f.question}</summary>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600" set:html={renderInlineMarkdown(f.answer)} />
                </details>
              ))}
            </div>
          </section>
        )}

        {showCommercialBrands && (
          <section class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-xl font-bold text-slate-900">文中对照提及的代表品牌评测与套餐入口</h2>
              <a href="/compare/" class="text-xs font-semibold text-brand hover:underline">查看品牌横向对比 →</a>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              {relatedBrands.slice(0, 4).map((b) => <BrandCard brand={b} />)}
            </div>
          </section>
        )}

        {siblingArticles.length > 0 && (
          <section class="rounded-2xl border border-slate-200 bg-slate-50 p-6 space-y-4">
            <h2 class="text-lg font-bold text-slate-900">同集群延伸长尾问题指南</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {siblingArticles.map((sa) => (
                <a href={`/articles/${sa.id}/`} class="rounded-xl border border-slate-200 bg-white p-4 hover:border-brand transition-colors">
                  <span class="block text-xs font-mono text-brand">{sa.data.category}</span>
                  <span class="mt-1 block text-sm font-bold text-slate-900 line-clamp-2">{sa.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="lg:col-span-4 space-y-5">
        <div class="sticky top-24 space-y-5">
          {headings.length > 0 && (
            <nav aria-label="文章目录" class="hidden lg:block rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">文章目录</h2>
              <ul class="space-y-1.5 text-xs">
                {headings.filter((h) => h.depth <= 3).map((h) => (
                  <li class={h.depth === 3 ? 'pl-3' : ''}>
                    <a href={`#${h.slug}`} class="text-slate-600 hover:text-brand">{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {entry.data.relatedLinks.length > 0 && (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 space-y-2.5">
              <h2 class="text-sm font-bold text-slate-900">下一步推荐与内部链接</h2>
              <ul class="space-y-2 text-xs">
                {entry.data.relatedLinks.map((rl) => (
                  <li><a href={rl.href} class="text-brand hover:underline">→ {rl.label}</a></li>
                ))}
              </ul>
            </div>
          )}

          {relatedBrands.length > 0 && entry.data.ctaMode === 'task-only' && (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 space-y-2.5">
              <h2 class="text-sm font-bold text-slate-900">核验兼容参考（非推广强插）</h2>
              <ul class="space-y-1.5 text-xs">
                {relatedBrands.slice(0, 3).map((b) => (
                  <li>
                    <a href={b.hasDeepReview ? `/reviews/${b.slug}/` : `/brands/${b.slug}/`} class="text-slate-700 hover:text-brand">
                      查看 {b.name} 兼容记录与评测 →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {entry.data.sources.length > 0 && (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs text-slate-600 space-y-1.5">
              <h2 class="font-bold text-slate-900">资料与验证来源</h2>
              <ul class="list-disc pl-4 space-y-1">
                {entry.data.sources.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
