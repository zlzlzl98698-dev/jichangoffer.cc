---
import type { BrandRecord } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL } from '../../data/links/brands';
import { siteConfig } from '../../config/site';

export interface Props {
  brands: BrandRecord[];
  title?: string;
  placement?: string;
}

const {
  brands,
  title = '本专题推荐与对照品牌速览总表',
  placement = 'topic-comparison-matrix',
} = Astro.props;
---

{
  brands.length > 0 && (
    <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm space-y-4">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-brand font-semibold">
            Quick Decision Matrix · 核心指标横向速查
          </span>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">{title}</h2>
        </div>
        <span class="text-xs text-slate-500">严格区分月付起步与年付折算价</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-700">
              <th class="px-3 py-3">品牌</th>
              <th class="px-3 py-3">起步参考口径</th>
              <th class="px-3 py-3">线路与协议</th>
              <th class="px-3 py-3">客户端兼容性</th>
              <th class="px-3 py-3">优惠码</th>
              <th class="px-3 py-3">实测状态</th>
              <th class="px-3 py-3 text-right">评测 / 注册入口</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {brands.map((b) => {
              const link = getBrandLink(b.slug);
              const hasPng = b.testReports.some((r) => Boolean(r.evidenceImage));
              return (
                <tr class="hover:bg-slate-50/80">
                  <td class="px-3 py-3 font-bold text-slate-900 whitespace-nowrap">
                    <div class="flex items-center gap-1.5">
                      <a href={`/brands/${b.slug}/`} class="hover:text-brand">{b.name}</a>
                      {b.featuredPlacement === 'primary-sponsor' && (
                        <span class="rounded bg-brand-soft px-1.5 py-0.5 text-[10px] font-semibold text-brand">
                          主推
                        </span>
                      )}
                    </div>
                    <span class="block text-[11px] font-normal text-slate-500">
                      {b.foundedYear ? `${b.foundedYear}年起` : b.foundedYearNote || '年份待核实'}
                    </span>
                  </td>
                  <td class="px-3 py-3 font-mono text-xs text-slate-800 max-w-[180px]">
                    {b.lowestMonthlyLabel}
                  </td>
                  <td class="px-3 py-3 text-xs text-slate-700">
                    <span class="block font-medium">{b.routeTypes[0]}</span>
                    <span class="text-slate-500">{b.protocols[0]}</span>
                  </td>
                  <td class="px-3 py-3 text-xs text-slate-700">
                    {b.clientMode === 'self-built-and-third-party'
                      ? '自研 + 第三方订阅'
                      : b.clientMode === 'third-party-supported'
                      ? '支持第三方订阅'
                      : b.clientMode === 'exclusive-client-only'
                      ? '仅专属客户端'
                      : '待核实'}
                  </td>
                  <td class="px-3 py-3 font-mono text-xs">
                    {link?.couponCode ? (
                      <code class="rounded bg-slate-100 border border-slate-200 px-1.5 py-0.5 font-bold text-slate-900">
                        {link.couponCode}
                      </code>
                    ) : (
                      <span class="text-slate-400">—</span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-xs whitespace-nowrap">
                    {hasPng ? (
                      <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-emerald-700">
                        含原始实测图
                      </span>
                    ) : b.testReports.length > 0 ? (
                      <span class="rounded-full bg-sky-50 border border-sky-200 px-2 py-0.5 text-sky-700">
                        含快照记录
                      </span>
                    ) : (
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">
                        待补实测
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1.5">
                      <a
                        href={`/reviews/${b.slug}/`}
                        class="rounded border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-brand hover:text-brand"
                      >
                        评测
                      </a>
                      {link?.affiliateUrl && (
                        <a
                          href={link.affiliateUrl}
                          target="_blank"
                          rel={AFFILIATE_REL}
                          data-cta-track
                          data-cta-brand={b.slug}
                          data-cta-placement={placement}
                          data-cta-content-type="comparison-table"
                          class="rounded bg-brand px-2.5 py-1 text-xs font-semibold text-white hover:bg-brand-dark"
                        >
                          官网 ↗
                        </a>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="text-[11px] text-slate-500 border-t border-slate-100 pt-2.5">
        {siteConfig.shortDisclosure} 表中排名顺序不代表绝对速度第一，具体适用条件请点击各品牌「评测」核查。
      </p>
    </section>
  )
}
