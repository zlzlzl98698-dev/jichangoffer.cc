---
import { siteConfig, getCanonicalUrl } from '../../config/site';
import { stripInlineMarkdown } from '../../lib/inlineMarkdown';

export interface BreadcrumbItem {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  description: string;
  pathname: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: Array<{ question: string; answer: string }>;
  jsonLdExtra?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  pathname,
  noindex = false,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  faqs = [],
  jsonLdExtra,
} = Astro.props;

const canonicalUrl = getCanonicalUrl(pathname);
const baseUrl = siteConfig.siteUrl.replace(/\/+$/, '');
const rawOgImage = ogImage || '/og-default.png';
const ogImageUrl = rawOgImage.startsWith('http')
  ? rawOgImage
  : `${baseUrl}${rawOgImage.startsWith('/') ? rawOgImage : `/${rawOgImage}`}`;
const fullTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';

const schemas: Array<Record<string, unknown>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
    description: siteConfig.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.siteUrl,
    inLanguage: siteConfig.language,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteConfig.siteUrl}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];

if (breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.label,
      item: getCanonicalUrl(b.href),
    })),
  });
}

if (faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: stripInlineMarkdown(f.question),
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripInlineMarkdown(f.answer),
      },
    })),
  });
}

if (jsonLdExtra) {
  if (Array.isArray(jsonLdExtra)) {
    schemas.push(...jsonLdExtra);
  } else {
    schemas.push(jsonLdExtra);
  }
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
{siteConfig.verification.google && (
  <meta name="google-site-verification" content={siteConfig.verification.google} />
)}
{siteConfig.verification.bing && (
  <meta name="msvalidate.01" content={siteConfig.verification.bing} />
)}
{siteConfig.verification.shenma && (
  <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />
)}
{siteConfig.verification.baidu && (
  <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />
)}
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/webp" href="/favicon.webp" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />

<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
