---
export interface Props {
  variant: 'tun-vs-proxy' | 'iepl-vs-transit' | 'dns-fakeip';
}

const { variant } = Astro.props;
---

<section class="rounded-2xl border border-observatory-border bg-observatory text-slate-100 p-5 sm:p-6 observatory-grid">
  {variant === 'tun-vs-proxy' && (
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-blue-300">Architecture Diagram · 原理示意图</span>
          <h2 class="text-base sm:text-lg font-bold text-white">系统代理 (HTTP/SOCKS) vs TUN 虚拟网卡接管路径</h2>
        </div>
        <span class="rounded border border-slate-700 bg-slate-800 px-2.5 py-0.5 font-mono text-[11px] text-slate-300">Zero-JS Vector</span>
      </div>

      <svg viewBox="0 0 820 230" class="w-full h-auto" role="img" aria-label="系统代理与TUN虚拟网卡流量接管路径对比图">
        <defs>
          <marker id="arrow-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#38bdf8" />
          </marker>
          <marker id="arrow-emerald" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#34d399" />
          </marker>
          <marker id="arrow-rose" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#fb7185" />
          </marker>
        </defs>

        <!-- Row 1: System Proxy -->
        <rect x="16" y="16" width="788" height="90" rx="10" fill="#111a2e" stroke="#1e293b" />
        <text x="32" y="38" fill="#94a3b8" font-size="11" font-family="monospace">PATH A · 系统代理模式 (仅应用层读取 127.0.0.1:7897)</text>
        <rect x="32" y="50" width="150" height="42" rx="6" fill="#0f172a" stroke="#38bdf8" />
        <text x="107" y="75" fill="#f8fafc" font-size="12" text-anchor="middle">Chrome / Edge 浏览器</text>
        <line x1="182" y1="71" x2="262" y2="71" stroke="#38bdf8" stroke-width="2" marker-end="url(#arrow-blue)" />
        <rect x="266" y="50" width="175" height="42" rx="6" fill="#0f172a" stroke="#38bdf8" />
        <text x="353" y="75" fill="#bae6fd" font-size="12" text-anchor="middle">Clash 本地端口 :7897</text>
        <line x1="441" y1="71" x2="495" y2="71" stroke="#38bdf8" stroke-width="2" marker-end="url(#arrow-blue)" />

        <rect x="500" y="50" width="140" height="42" rx="6" fill="#0f172a" stroke="#fb7185" />
        <text x="570" y="75" fill="#fecdd3" font-size="12" text-anchor="middle">Git / curl / Docker</text>
        <line x1="640" y1="71" x2="700" y2="71" stroke="#fb7185" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#arrow-rose)" />
        <text x="748" y="75" fill="#fda4af" font-size="11" text-anchor="middle">绕过端口(超时)</text>

        <!-- Row 2: TUN Mode -->
        <rect x="16" y="122" width="788" height="92" rx="10" fill="#111a2e" stroke="#1e293b" />
        <text x="32" y="144" fill="#6ee7b7" font-size="11" font-family="monospace">PATH B · TUN 虚拟网卡模式 (三层 IP 包全部接管后统一按 Rule 分流)</text>
        <rect x="32" y="156" width="190" height="42" rx="6" fill="#0f172a" stroke="#34d399" />
        <text x="127" y="181" fill="#f8fafc" font-size="12" text-anchor="middle">浏览器 + 终端 + 游戏/App</text>
        <line x1="222" y1="177" x2="288" y2="177" stroke="#34d399" stroke-width="2" marker-end="url(#arrow-emerald)" />
        <rect x="292" y="156" width="190" height="42" rx="6" fill="#0f172a" stroke="#34d399" />
        <text x="387" y="181" fill="#a7f3d0" font-size="12" text-anchor="middle">TUN 虚拟网卡 (Service 模式)</text>
        <line x1="482" y1="177" x2="546" y2="177" stroke="#34d399" stroke-width="2" marker-end="url(#arrow-emerald)" />
        <rect x="550" y="156" width="234" height="42" rx="6" fill="#064e3b" stroke="#34d399" />
        <text x="667" y="181" fill="#ecfdf5" font-size="12" text-anchor="middle">Mihomo / sing-box 内核分流转发</text>
      </svg>
    </div>
  )}

  {variant === 'iepl-vs-transit' && (
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-blue-300">Network Transport Comparison · 线路传输原理示意</span>
          <h2 class="text-base sm:text-lg font-bold text-white">IEPL/IPLC 私有专线 vs 公网隧道中转 vs 公网直连</h2>
        </div>
        <span class="rounded border border-slate-700 bg-slate-800 px-2.5 py-0.5 font-mono text-[11px] text-slate-300">Architecture Note</span>
      </div>

      <svg viewBox="0 0 820 215" class="w-full h-auto" role="img" aria-label="IEPL专线与公网中转和直连传输路径对比图">
        <!-- Line 1: IEPL -->
        <rect x="16" y="14" width="788" height="58" rx="8" fill="#111a2e" stroke="#1e293b" />
        <text x="30" y="48" fill="#34d399" font-size="12" font-weight="bold">IEPL / IPLC</text>
        <rect x="130" y="25" width="135" height="36" rx="6" fill="#0f172a" stroke="#475569" />
        <text x="197" y="47" fill="#e2e8f0" font-size="11" text-anchor="middle">国内 BGP 入口节点</text>
        <line x1="265" y1="43" x2="465" y2="43" stroke="#10b981" stroke-width="4" />
        <text x="365" y="34" fill="#6ee7b7" font-size="10" text-anchor="middle">运营商私有内网专线 (绕开公网拥塞)</text>
        <rect x="465" y="25" width="145" height="36" rx="6" fill="#0f172a" stroke="#10b981" />
        <text x="537" y="47" fill="#ecfdf5" font-size="11" text-anchor="middle">海外落地 (HK/JP/SG)</text>
        <text x="705" y="47" fill="#6ee7b7" font-size="11" text-anchor="middle">晚高峰丢包极低</text>

        <!-- Line 2: Public Transit -->
        <rect x="16" y="82" width="788" height="58" rx="8" fill="#111a2e" stroke="#1e293b" />
        <text x="30" y="116" fill="#38bdf8" font-size="12" font-weight="bold">公网隧道中转</text>
        <rect x="130" y="93" width="135" height="36" rx="6" fill="#0f172a" stroke="#475569" />
        <text x="197" y="115" fill="#e2e8f0" font-size="11" text-anchor="middle">国内中转机房</text>
        <line x1="265" y1="111" x2="465" y2="111" stroke="#38bdf8" stroke-width="2" />
        <text x="365" y="102" fill="#bae6fd" font-size="10" text-anchor="middle">公网加密隧道转发 (成本适中)</text>
        <rect x="465" y="93" width="145" height="36" rx="6" fill="#0f172a" stroke="#38bdf8" />
        <text x="537" y="115" fill="#f8fafc" font-size="11" text-anchor="middle">海外落地服务器</text>
        <text x="705" y="115" fill="#bae6fd" font-size="11" text-anchor="middle">性价比高·受公网波动</text>

        <!-- Line 3: Direct -->
        <rect x="16" y="150" width="788" height="52" rx="8" fill="#111a2e" stroke="#1e293b" />
        <text x="30" y="180" fill="#fb7185" font-size="12" font-weight="bold">无中转直连</text>
        <rect x="130" y="159" width="135" height="34" rx="6" fill="#0f172a" stroke="#475569" />
        <text x="197" y="180" fill="#e2e8f0" font-size="11" text-anchor="middle">本地家庭宽带</text>
        <line x1="265" y1="176" x2="465" y2="176" stroke="#fb7185" stroke-width="2" stroke-dasharray="5 4" />
        <text x="365" y="168" fill="#fecdd3" font-size="10" text-anchor="middle">直接经过公网国际出口</text>
        <rect x="465" y="159" width="145" height="34" rx="6" fill="#0f172a" stroke="#fb7185" />
        <text x="537" y="180" fill="#f8fafc" font-size="11" text-anchor="middle">海外 VPS</text>
        <text x="705" y="180" fill="#fda4af" font-size="11" text-anchor="middle">晚高峰易丢包断流</text>
      </svg>
    </div>
  )}

  {variant === 'dns-fakeip' && (
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-blue-300">DNS Pipeline · 解析机制原理图</span>
          <h2 class="text-base sm:text-lg font-bold text-white">Fake-IP 模式如何消除本地等待并防止 DNS 泄漏</h2>
        </div>
        <span class="rounded border border-slate-700 bg-slate-800 px-2.5 py-0.5 font-mono text-[11px] text-slate-300">Mihomo / sing-box</span>
      </div>

      <svg viewBox="0 0 820 155" class="w-full h-auto" role="img" aria-label="Fake-IP DNS解析防泄漏原理图">
        <rect x="16" y="20" width="175" height="58" rx="8" fill="#111a2e" stroke="#38bdf8" />
        <text x="103" y="45" fill="#f8fafc" font-size="12" font-weight="bold" text-anchor="middle">1. 浏览器请求域名</text>
        <text x="103" y="64" fill="#94a3b8" font-size="11" text-anchor="middle">chatgpt.com</text>

        <line x1="191" y1="49" x2="236" y2="49" stroke="#38bdf8" stroke-width="2" />

        <rect x="236" y="20" width="215" height="58" rx="8" fill="#111a2e" stroke="#34d399" />
        <text x="343" y="45" fill="#6ee7b7" font-size="12" font-weight="bold" text-anchor="middle">2. 内核秒回 Fake-IP</text>
        <text x="343" y="64" fill="#a7f3d0" font-size="11" font-family="monospace" text-anchor="middle">198.18.0.42 (本地零等待)</text>

        <line x1="451" y1="49" x2="496" y2="49" stroke="#34d399" stroke-width="2" />

        <rect x="496" y="20" width="308" height="58" rx="8" fill="#064e3b" stroke="#34d399" />
        <text x="650" y="45" fill="#ecfdf5" font-size="12" font-weight="bold" text-anchor="middle">3. 还原域名走远程节点解析</text>
        <text x="650" y="64" fill="#d1fae5" font-size="11" text-anchor="middle">本地 ISP 不参与查询 → 消除 DNS 泄漏</text>

        <text x="16" y="114" fill="#cbd5e1" font-size="11">提示：若浏览器开启了「安全 DNS (DoH)」，浏览器会绕开步骤 2 自行查出真实 IP，导致分流失效或延迟升高。</text>
        <text x="16" y="135" fill="#94a3b8" font-size="11">退掉软件后如残留 198.18.x.x 缓存，执行 ipconfig /flushdns（Windows）即可清空。</text>
      </svg>
    </div>
  )}
</section>
