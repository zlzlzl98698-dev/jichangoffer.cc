---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { BrandRecord } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL } from '../../data/links/brands';

export interface Props {
  brand: BrandRecord;
}

const { brand } = Astro.props;
const link = getBrandLink(brand.slug);
const hasMeasured = brand.testReports.some((r) => r.dataStatus === 'measured');
const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/*.{png,jpg,jpeg,webp}', { eager: true });
const brandLogo = Object.entries(logos).find(([k]) => k.includes(`${brand.slug}-icon`))?.[1]?.default;
---

<article
  class="brand-filter-card flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md"
  data-name={`${brand.name} ${brand.aliases.join(' ')} ${brand.tags.join(' ')}`.toLowerCase()}
  data-price={brand.lowestMonthlyCny !== null ? String(brand.lowestMonthlyCny) : '999'}
  data-monthly={brand.hasMonthlyPlan ? '1' : '0'}
  data-annual={brand.hasAnnualPlan ? '1' : '0'}
  data-unlimited={brand.hasUnlimitedTimePlan ? '1' : '0'}
  data-routes={brand.routeTypes.join(' ').toLowerCase()}
  data-client-mode={brand.clientMode}
  data-ai={brand.aiCompatibility.some((a) => a.status === 'verified-supported' || a.status === 'vendor-claimed' || a.status === 'partial-or-node-dependent') ? '1' : '0'}
  data-streaming={brand.streamingCompatibility.some((s) => s.status === 'verified-supported' || s.status === 'vendor-claimed' || s.status === 'partial-or-node-dependent') ? '1' : '0'}
  data-priority={String(brand.editorialPriority)}
>
  <div>
    <!-- Card Header -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        {brandLogo ? (
          <Image
            src={brandLogo}
            alt={`${brand.name} 官方图标`}
            class="h-11 w-11 shrink-0 rounded-lg object-cover shadow-sm border border-slate-200"
          />
        ) : (
          <span
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg font-mono text-sm font-bold text-white shadow-sm"
            style={`background-color: ${brand.brandColor};`}
          >
            {brand.logoMonogram}
          </span>
        )}
        <div>
          <div class="flex flex-wrap items-center gap-1.5">
            <h3 class="text-base font-bold text-slate-900">
              <a href={`/brands/${brand.slug}/`} class="hover:text-brand transition-colors">
                {brand.name}
              </a>
            </h3>
            {brand.featuredPlacement === 'primary-sponsor' && (
              <span class="rounded bg-brand-soft border border-blue-200 px-1.5 py-0.5 text-[10px] font-semibold text-brand">
                重点推荐
              </span>
            )}
          </div>
          <p class="text-xs text-slate-500">
            {brand.foundedYear ? `${brand.foundedYear} 年起运营` : brand.foundedYearNote || '年份待核实'} · 核验 {brand.verifiedAt}
          </p>
        </div>
      </div>

      <span
        class:list={[
          'shrink-0 rounded-full px-2 py-0.5 text-[11px] font-mono font-medium border',
          hasMeasured
            ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
            : brand.dataStatus === 'conflict'
            ? 'bg-amber-50 text-amber-800 border-amber-200'
            : 'bg-slate-100 text-slate-600 border-slate-200',
        ]}
      >
        {hasMeasured ? '含实测证据' : brand.dataStatus === 'conflict' ? '存在资料冲突' : brand.dataStatus === 'vendor' ? '品牌资料' : '待核实'}
      </span>
    </div>

    <!-- Summary -->
    <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3">
      {brand.summary}
    </p>

    <!-- Key Metrics -->
    <dl class="mt-4 grid grid-cols-2 gap-2.5 rounded-lg bg-slate-50 p-3 text-xs border border-slate-100">
      <div>
        <dt class="text-slate-500">最低参考起步</dt>
        <dd class="mt-0.5 font-mono font-semibold text-slate-900">
          {brand.lowestMonthlyCny !== null ? `¥${brand.lowestMonthlyCny}/月起` : '待核实'}
        </dd>
      </div>
      <div>
        <dt class="text-slate-500">客户端模式</dt>
        <dd class="mt-0.5 font-medium text-slate-800 truncate">
          {brand.clientMode === 'self-built-and-third-party'
            ? '自研+第三方'
            : brand.clientMode === 'exclusive-client-only'
            ? '仅专属客户端'
            : brand.clientMode === 'third-party-supported'
            ? '支持第三方订阅'
            : '待核实'}
        </dd>
      </div>
      <div>
        <dt class="text-slate-500">线路与协议</dt>
        <dd class="mt-0.5 font-medium text-slate-800 truncate">
          {brand.routeTypes[0] || '待核实'}
        </dd>
      </div>
      <div>
        <dt class="text-slate-500">优惠码</dt>
        <dd class="mt-0.5 font-mono font-semibold text-slate-900 truncate">
          {link?.couponCode || '暂无/待核实'}
        </dd>
      </div>
    </dl>

    <!-- Tags -->
    <div class="mt-3 flex flex-wrap gap-1.5">
      {brand.tags.slice(0, 4).map((t) => (
        <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] text-slate-600">{t}</span>
      ))}
    </div>
  </div>

  <!-- Actions -->
  <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3.5">
    <a
      href={`/brands/${brand.slug}/`}
      class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-center text-xs font-semibold text-slate-800 hover:bg-slate-50 transition-colors"
    >
      品牌档案
    </a>
    <a
      href={`/reviews/${brand.slug}/`}
      class="flex-1 rounded-lg border border-blue-200 bg-brand-soft px-3 py-2 text-center text-xs font-semibold text-brand hover:bg-blue-100 transition-colors"
    >
      深度评测
    </a>
    {link?.affiliateUrl && (
      <a
        href={link.affiliateUrl}
        target="_blank"
        rel={AFFILIATE_REL}
        data-cta-track
        data-cta-brand={brand.slug}
        data-cta-placement="brand-card"
        data-cta-content-type="brand-directory"
        class="rounded-lg bg-observatory px-3 py-2 text-center text-xs font-semibold text-white hover:bg-brand transition-colors"
      >
        官网 ↗
      </a>
    )}
  </div>
</article>
